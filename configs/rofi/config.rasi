configuration {
	modi:				"drun";
	font:				"Z003 10";
	show-icons:			true;
	icon-theme:			"Reversal-dark";
	display-drun:			"";
	drun-display-format:		"{name}";
	sidebar-mode:			false;
}

@theme "/dev/null"

* {
	bg:				#000000;
	fg:				#FFD700;
	accent:				#FFD700;
	button:				#1c1c1c;
	background-color:		@bg;
	text-color:			@fg;
}

window {
	border-radius:			7px;
	border-color:			#FFD700;
	border:				2px;
	width:				50%;
	padding:			32px;
}

prompt {
	background-color:		@button;
	enabled:			true;
	padding:			0.5% 32px 0% -0.5%;
	font:				"Z003 10";
}

entry {
	placeholder:			"Search";
	background-color:		@button;
	placeholder-color:		#FFD700;
	expand:				true;
	padding:			0.15% 0% 0% 0%;
}

inputbar {
	children:			[prompt, entry];
	background-color:		@button;
	expand:				false;
	border-radius:			6px;
	margin:				0%;
	padding:			10px;
	border-color:			#FFD700;
	border:				1px;
}

listview {
	columns:			4;
	lines:				5;
	cycle:				false;
	dynamic:			true;
	layout:				vertical;
}

mainbox {
	children:			[inputbar, listview];
	spacing:			2%;
	padding:			2% 1% 2% 1%;
}

element {
	orientation:			vertical;
	padding:			2% 0% 2% 0%;
}

element-icon {
	size:				38px;
	horizontal-align:		0.5;
}

element-text {
	expand:				true;
	horizontal-align:		0.5;
	vertical-align:			0.5;
	margin:				0.5% 0.5% -0.5% 0.5%;
}

element selected {
	background-color:		#FFD700;
	border-radius:			6px;
}

element selected element-text {
	text-color:			#000000;
}
